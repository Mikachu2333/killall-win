#include <winver.h>

#ifndef DEBUG
#define VER_DEBUG 0
#else
#define VER_DEBUG VS_FF_DEBUG
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @KILLALL_RC_FILEVERSION@
PRODUCTVERSION  @KILLALL_RC_PRODUCTVERSION@
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       (VER_DEBUG)
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "@KILLALL_COMPANY@"
            VALUE "FileDescription",  "@KILLALL_DESCRIPTION@"
            VALUE "FileVersion",      "@KILLALL_RC_FILEVERSION_STR@"
            VALUE "InternalName",     "@KILLALL_INTERNAL_NAME@"
            VALUE "LegalCopyright",   "@KILLALL_COPYRIGHT@"
            VALUE "OriginalFilename", "@KILLALL_ORIGINAL_FILENAME@"
            VALUE "ProductName",      "@KILLALL_PRODUCT_NAME@"
            VALUE "ProductVersion",   "@KILLALL_RC_PRODUCTVERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
